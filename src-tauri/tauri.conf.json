{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tunepeek",
  "version": "0.1.0",
  "identifier": "dev.tunepeek.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "flyout",
        "url": "index.html",
        "width": 380,
        "height": 140,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "focus": false,
        "focusable": false,
        "shadow": true
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "Tunepeek settings",
        "width": 460,
        "height": 660,
        "visible": false,
        "center": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "publisher": "Tunepeek",
    "category": "Music",
    "shortDescription": "Now-playing flyout for media applications",
    "longDescription": "A tiny always-on-top flyout with song info, seeking, playback controls and per-app volume, opened with a hotkey.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}